---
import { USE_CASES, USE_CASE_FILTERS } from '../consts';
---

<section id="use-cases" class="max-w-screen-xl mx-auto px-6 pb-20" aria-labelledby="usecases-heading">
  <div class="text-center mb-8">
    <div class="inline-block px-4 py-1 text-xs font-semibold tracking-[2px] text-emerald-400 bg-emerald-400/10 rounded-2xl mb-4">BUILT FOR VISIONARIES</div>
    <h2 id="usecases-heading" class="section-header tracking-tighter">Perfect for premium<br />crypto &amp; Web3 projects</h2>
    <p class="mt-3 max-w-md mx-auto text-lg text-zinc-400">This name positions your project as a rare and desirable digital jewel in a crowded market.</p>
  </div>

  <!-- Portfolio-style category filter (crypto / business / luxury / brandable) -->
  <div class="flex flex-wrap items-center justify-center gap-2 mb-8" role="group" aria-label="Filter use cases by category">
    {USE_CASE_FILTERS.map((f, i) => (
      <button
        type="button"
        data-filter={f.value}
        data-track={`filter-usecase-${f.value}`}
        aria-pressed={i === 0 ? 'true' : 'false'}
        class={`tap-target filter-btn inline-flex items-center rounded-2xl border px-5 text-sm font-semibold transition-all ${i === 0 ? 'border-emerald-400 bg-emerald-400 text-zinc-950' : 'border-zinc-700 text-zinc-300 hover:bg-zinc-900'}`}
      >
        {f.label}
      </button>
    ))}
  </div>

  <div id="usecase-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {USE_CASES.map((useCase) => (
      <article data-category={useCase.category} class="usecase-card reveal premium-card group bg-zinc-900 border border-zinc-700 hover:border-emerald-400/40 rounded-3xl p-7 flex flex-col">
        <div class="use-case-icon w-11 h-11 rounded-2xl bg-gradient-to-br from-emerald-400/10 to-transparent flex items-center justify-center mb-5 text-emerald-400" aria-hidden="true">
          <i class={`fa-solid ${useCase.icon} text-2xl`}></i>
        </div>
        <h3 class="font-semibold text-xl tracking-tight mb-2 text-white">{useCase.title}</h3>
        <p class="text-base text-zinc-400 flex-1">{useCase.description}</p>
      </article>
    ))}
  </div>
  <p id="usecase-empty" class="hidden mt-6 text-center text-zinc-500">No projects in this category.</p>
</section>
