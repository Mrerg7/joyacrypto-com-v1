---
import { FAQS } from '../consts';
---

<!-- FAQ: linkable content asset (SEO) + DA building via valuation/process guides -->
<section id="faq" class="max-w-screen-xl mx-auto px-6 py-20" aria-labelledby="faq-heading">
  <div class="max-w-3xl mx-auto text-center mb-10">
    <div class="inline-block px-4 py-1 text-xs font-semibold tracking-[2px] text-emerald-400 bg-emerald-400/10 rounded-2xl mb-4">DOMAIN VALUATION &amp; TRANSFER GUIDE</div>
    <h2 id="faq-heading" class="section-header tracking-tighter">Frequently asked <span class="jewel-text">questions</span></h2>
    <p class="mt-4 text-lg text-zinc-400">How premium domain sales, escrow, and transfers work — plus what makes Joyacrypto.com valuable.</p>
  </div>

  <div class="max-w-3xl mx-auto grid gap-3">
    {FAQS.map((f, i) => (
      <details class="reveal group rounded-2xl border border-zinc-800 bg-zinc-900 px-6 py-4 open:border-emerald-400/40" name="faq">
        <summary class="tap-target flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-white">
          <span>{f.q}</span>
          <i class="fa-solid fa-chevron-down text-emerald-400 transition-transform group-open:rotate-180" aria-hidden="true"></i>
        </summary>
        <p class="mt-3 text-base leading-relaxed text-zinc-400">{f.a}</p>
        {i === 1 && (
          <p class="mt-3 text-sm">
            <a href="#contact" class="text-emerald-400 underline hover:text-emerald-300" data-track="cta-faq-escrow">Start a secure inquiry →</a>
          </p>
        )}
      </details>
    ))}
  </div>

  <nav class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-zinc-500" aria-label="Related sections">
    <span class="uppercase tracking-widest text-xs">Keep exploring:</span>
    <a class="hover:text-emerald-400 underline" href="#meaning">The name</a>
    <a class="hover:text-emerald-400 underline" href="#opportunity">The opportunity</a>
    <a class="hover:text-emerald-400 underline" href="#why-premium">Why premium</a>
    <a class="hover:text-emerald-400 underline" href="#use-cases">Use cases</a>
    <a class="hover:text-emerald-400 underline" href="#contact">Acquire</a>
  </nav>
</section>
