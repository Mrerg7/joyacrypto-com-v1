---
import { SITE, NAV_LINKS } from '../consts';
---

<footer class="border-t border-zinc-800 bg-zinc-950">
  <!-- Domain Acquisition CTA -->
  <div class="max-w-screen-xl mx-auto px-6 pt-14 pb-10">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-7 max-w-3xl mx-auto md:mx-0 text-center md:text-left">
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400/20 to-emerald-400/5 border border-emerald-400/30 mb-6" aria-hidden="true">
          <i class="fa-solid fa-gem text-2xl text-emerald-400"></i>
        </div>

        <h2 class="text-2xl md:text-3xl font-semibold tracking-tighter mb-3">
          <span class="text-white">Joyacrypto.com</span>{' '}
          <span class="text-zinc-500" data-i18n="footer.tag">is available for acquisition</span>
        </h2>

        <p class="text-base text-zinc-400 max-w-lg mx-auto md:mx-0 mb-8 leading-relaxed">
          A rare premium .com domain positioned for luxury crypto, premium DeFi, and enduring digital wealth platforms.
          Serious inquiries from qualified founders, organizations, and their representatives are welcomed.
        </p>

        <div class="flex flex-col sm:flex-row sm:justify-start items-center justify-center gap-4">
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Acquisition: Joyacrypto.com')}`}
             data-track="cta-footer-inquire"
             class="tap-target group inline-flex items-center justify-center gap-x-3 px-8 font-semibold rounded-2xl bg-gradient-to-r from-emerald-400 to-emerald-500 hover:from-emerald-300 hover:to-emerald-400 active:scale-[0.985] text-zinc-950 shadow-lg shadow-emerald-400/20 transition-all">
            <i class="fa-solid fa-envelope group-hover:-translate-y-px transition-transform" aria-hidden="true"></i>
            <span>Inquire: {SITE.email}</span>
          </a>
          <span class="text-sm text-zinc-600">Private sale • Escrow available</span>
        </div>
      </div>

      <!-- Internal linking: category / portfolio collections -->
      <nav class="md:col-span-5 grid sm:grid-cols-2 gap-8 text-base" aria-label="Footer">
        <div>
          <h3 class="text-xs uppercase tracking-[2px] text-zinc-500 font-semibold mb-4" data-i18n="footer.explore">Explore</h3>
          <ul class="space-y-1">
            {NAV_LINKS.map((l) => (
              <li><a href={l.href} class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">{l.label}</a></li>
            ))}
            <li><a href="#faq" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">FAQ &amp; Valuation Guide</a></li>
            <li><a href="#contact" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">Acquire Domain</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs uppercase tracking-[2px] text-zinc-500 font-semibold mb-4" data-i18n="footer.ideal">Ideal For</h3>
          <ul class="space-y-1">
            <li><a href="#use-cases" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">Luxury crypto brands</a></li>
            <li><a href="#use-cases" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">DeFi &amp; wealth platforms</a></li>
            <li><a href="#use-cases" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">NFT marketplaces</a></li>
            <li><a href="#use-cases" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">Tokenized assets (RWA)</a></li>
            <li><a href="#use-cases" class="tap-target inline-flex items-center text-zinc-400 hover:text-emerald-400 transition-colors">Crypto education</a></li>
          </ul>
        </div>
      </nav>
    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-zinc-800"></div>

  <!-- Bottom Bar -->
  <div class="max-w-screen-xl mx-auto px-6 py-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-y-4 text-sm text-zinc-500">
      <div>
        <span class="text-zinc-400">&copy; 2026 Joyacrypto.com.</span>{' '}
        <span class="text-xs">Premium digital asset offered by private seller.</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs">
        <a href="#faq" class="tap-target inline-flex items-center hover:text-zinc-300 transition-colors">How Escrow Works</a>
        <span class="text-zinc-700" aria-hidden="true">•</span>
        <a href="#why-premium" class="tap-target inline-flex items-center hover:text-zinc-300 transition-colors">Comparable Sales</a>
        <span class="text-zinc-700" aria-hidden="true">•</span>
        <span>Escrow via trusted partners</span>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="mt-6 pt-5 border-t border-zinc-800/50">
      <p class="text-xs text-zinc-600 leading-relaxed text-center max-w-3xl mx-auto">
        {SITE.disclaimer}
      </p>
    </div>
  </div>
</footer>
