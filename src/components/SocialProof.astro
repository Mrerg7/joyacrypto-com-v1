---
import { TRUST_SIGNALS, COMPARABLE_SALES, TESTIMONIALS } from '../consts';
---

<!-- Trust + social proof: escrow badges, recent-sales context, testimonials -->
<section class="border-b border-zinc-800 bg-zinc-900/50" aria-labelledby="trust-heading">
  <div class="max-w-screen-xl mx-auto px-6 py-10">
    <h2 id="trust-heading" class="sr-only">Buyer protection and social proof</h2>
    <div class="grid sm:grid-cols-3 gap-4 mb-8">
      {TRUST_SIGNALS.map((s) => (
        <div class="reveal flex items-center gap-x-3 rounded-2xl border border-zinc-800 bg-zinc-950 px-5 py-4">
          <div class="w-11 h-11 shrink-0 rounded-xl bg-emerald-400/10 flex items-center justify-center" aria-hidden="true">
            <i class={`fa-solid ${s.icon} text-xl text-emerald-400`}></i>
          </div>
          <div>
            <div class="font-semibold text-white leading-tight">{s.title}</div>
            <div class="text-sm text-zinc-400">{s.text}</div>
          </div>
        </div>
      ))}
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      <div class="reveal rounded-3xl border border-zinc-800 bg-zinc-950 p-7">
        <div class="text-xs uppercase tracking-[2px] text-emerald-400 font-semibold mb-4">WHY PREMIUM .COM WINS</div>
        <ul class="space-y-3 text-base text-zinc-300">
          {COMPARABLE_SALES.map((c) => (
            <li class="flex items-start justify-between gap-4 border-b border-zinc-800 pb-3 last:border-0 last:pb-0">
              <span>{c.domain}<span class="block text-sm text-zinc-500">{c.note}</span></span>
              <span class="shrink-0 text-right font-semibold text-white">{c.range}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-zinc-500">Category context for investment-grade domains. Specific pricing provided privately to qualified buyers.</p>
      </div>
      <div class="grid gap-4">
        {TESTIMONIALS.map((t) => (
          <figure class="reveal rounded-3xl border border-zinc-800 bg-zinc-950 p-6">
            <div class="text-emerald-400 tracking-widest text-sm mb-2" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote class="text-base text-zinc-200 leading-relaxed">“{t.quote}”</blockquote>
            <figcaption class="mt-3 text-sm text-zinc-500">— <span class="text-zinc-300 font-medium">{t.author}</span> · {t.role}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
